---
import type { CollectionEntry } from 'astro:content';
import { cohorteAbierta } from '../lib/cohortes';
import { formatoCLP, formatoFecha, mostrar } from '../lib/formato';
import { SITIO } from '../config/sitio';
import Diagrama from './Diagrama.astro';

interface Props {
  curso: CollectionEntry<'cursos'>;
  docentes: CollectionEntry<'docentes'>[];
}

const { curso, docentes } = Astro.props;
const d = curso.data;
const cohorte = cohorteAbierta(d.cohortes);
const AREA = { hidrogeologia: 'Hidrogeología', geociencias: 'Geociencias' } as const;
const duracion = d.horas === 'PENDIENTE' || d.semanas === 'PENDIENTE'
  ? mostrar('PENDIENTE')
  : `${d.horas} horas · ${d.semanas} semanas`;
---
<section class="ficha-hero contenedor" aria-labelledby="titulo-curso">
  <div class="ficha-hero__texto">
    <p class="chip">{AREA[d.area]}</p>
    <h1 id="titulo-curso">{d.titulo}</h1>
    <p class="ficha-hero__resumen">{d.resumen}</p>
    <p class="ficha-hero__docentes">Dictado por {docentes.map((p) => p.data.nombre).join(' y ')}</p>
    {d.diagrama && <div class="ficha-hero__figura"><Diagrama tipo={d.diagrama} id={`fig-${curso.id}`} /></div>}
  </div>

  <aside class="inscripcion" aria-label="Inscripción" id="inscripcion">
    {cohorte ? (
      <>
        <p class="inscripcion__etiqueta">Próxima cohorte</p>
        <p class="inscripcion__inicio">Inicia el {formatoFecha(cohorte.inicio)}</p>
        <dl class="inscripcion__datos">
          <div><dt>Modalidad</dt><dd>En vivo por Google Meet</dd></div>
          <div><dt>Horario</dt><dd>{mostrar(cohorte.horario)}</dd></div>
          <div><dt>Duración</dt><dd>{duracion}</dd></div>
          <div><dt>Cupos</dt><dd>{mostrar(cohorte.cupos)}</dd></div>
        </dl>
        <p class="inscripcion__precio">
          <span class="mono">{formatoCLP(d.precioCLP)}</span>
          <span class="inscripcion__moneda">CLP · precio único</span>
        </p>
        <a class="boton boton--primario inscripcion__cta" href={`/inscripcion/${curso.id}/`} data-cta-inscripcion>Inscribirme</a>
        <a class="inscripcion__convenio" href={`/convenios/?curso=${curso.id}`}>
          ¿Grupo de {SITIO.convenioMinimoAlumnos} o más? Convenio para empresas e instituciones
        </a>
      </>
    ) : (
      <>
        <p class="inscripcion__etiqueta">Sin cohorte abierta</p>
        <p class="inscripcion__inicio">La próxima cohorte aún no tiene fecha.</p>
        <a class="boton boton--secundario inscripcion__cta" href={`/cursos/${curso.id}/#informacion`}>Avísame de la próxima cohorte</a>
      </>
    )}
  </aside>
</section>

<style>
  .ficha-hero {
    display: grid;
    gap: var(--space-8);
    padding-block: var(--space-8) var(--space-12);
  }

  .ficha-hero > * {
    min-width: 0;
  }

  @media (min-width: 960px) {
    .ficha-hero {
      grid-template-columns: minmax(0, 1fr) 400px;
      align-items: start;
      gap: var(--space-16);
      padding-block: var(--space-24) var(--space-16);
    }
  }

  .ficha-hero__texto h1 {
    margin-top: var(--space-6);
    font-size: clamp(36px, 5.2vw, 64px);
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .ficha-hero__resumen {
    max-width: 56ch;
    margin-top: var(--space-6);
    font-size: clamp(18px, 1.6vw, 21px);
    color: var(--text-secondary);
  }

  .ficha-hero__docentes {
    margin-top: var(--space-6);
    font-weight: 600;
  }

  .ficha-hero__figura {
    margin-top: var(--space-12);
  }

  .inscripcion {
    padding: var(--space-8);
    border-radius: var(--radius-xl);
    background: var(--bg-surface);
  }

  .inscripcion__etiqueta {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand-accent);
  }

  .inscripcion__inicio {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
  }

  .inscripcion__datos {
    display: grid;
    gap: var(--space-3);
    margin-block: var(--space-6);
    padding-block: var(--space-6);
    border-block: 1px solid var(--border-subtle);
  }

  .inscripcion__datos div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .inscripcion__datos dt {
    color: var(--text-muted);
  }

  .inscripcion__datos dd {
    margin: 0;
    font-weight: 500;
    text-align: right;
  }

  .inscripcion__precio {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  .inscripcion__precio .mono {
    font-size: 40px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .inscripcion__moneda {
    color: var(--text-muted);
    font-size: 14px;
  }

  .inscripcion__cta {
    width: 100%;
    margin-top: var(--space-6);
    min-height: 56px;
    font-size: 17px;
  }

  .inscripcion__convenio {
    display: block;
    margin-top: var(--space-4);
    color: var(--text-secondary);
    font-size: 14px;
    text-align: center;
  }

  .inscripcion__convenio:hover {
    color: var(--text-primary);
  }
</style>
