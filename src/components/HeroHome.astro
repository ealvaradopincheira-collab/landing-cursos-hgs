---
import { getCollection } from 'astro:content';
import { cohorteAbierta } from '../lib/cohortes';
import { formatoFecha } from '../lib/formato';
import { SITIO } from '../config/sitio';

const cursos = await getCollection('cursos');
const inicios = cursos.map((c) => cohorteAbierta(c.data.cohortes)?.inicio).filter((v): v is string => Boolean(v)).sort();
const proximo = inicios[0];
---
<section class="hero" aria-labelledby="hero-titulo">
  <div class="hero__campo" aria-hidden="true">
    <slot name="fondo" />
  </div>
  <div class="contenedor hero__contenido">
    {proximo && (
      <a class="hero__anuncio" href="#cursos">
        <span class="hero__chip mono">Cohorte {cursos.length > 1 ? 'inicial' : ''}</span>
        Inicia el {formatoFecha(proximo)}
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    )}
    <h1 id="hero-titulo">Hidrogeología y geociencias aplicadas, en vivo</h1>
    <p class="hero__bajada">
      Cursos dictados por especialistas por Google Meet, con un entregable práctico en cada módulo.
    </p>
    <div class="hero__acciones">
      <a class="boton boton--primario" href="#cursos">Ver cursos</a>
      <a class="boton boton--secundario" href="/convenios/">Convenios desde {SITIO.convenioMinimoAlumnos} alumnos</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .hero__campo {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero__contenido {
    padding-block: var(--space-16) var(--space-24);
  }

  @media (min-width: 768px) {
    .hero__contenido {
      padding-block: var(--space-32) var(--space-32);
    }
  }

  .hero__anuncio {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-1) var(--space-4) var(--space-1) var(--space-1);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-pill);
    background: var(--bg-canvas);
    color: var(--text-secondary);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color var(--dur-base) var(--ease-out);
  }

  .hero__anuncio:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .hero__chip {
    flex-shrink: 0;
    white-space: nowrap;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--bg-inverse);
    color: var(--text-on-inverse);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  h1 {
    max-width: 14ch;
    margin-top: var(--space-8);
    font-size: var(--fs-display);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .hero__bajada {
    max-width: 44ch;
    margin-top: var(--space-6);
    color: var(--text-secondary);
    font-size: clamp(18px, 1.6vw, 21px);
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
