---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITIO } from '../config/sitio';
import { ruta } from '../lib/rutas';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo, descripcion = SITIO.descripcion } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITIO.nombre}` : `${SITIO.nombre} — ${SITIO.descriptor}`;
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#FAF9F6" />
    <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
    {SITIO.vistaPrevia && <meta name="robots" content="noindex" />}
    <!-- Tema elegido por el visitante, aplicado antes del primer pintado (Tarea 7.1) -->
    <script is:inline>
      try {
        if (localStorage.getItem('hgs-tema') === 'oscuro') {
          document.documentElement.dataset.theme = 'dark';
          document.querySelector('meta[name="theme-color"]').content = '#090D16';
        }
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />

    <Font cssVariable="--font-display" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-body" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    {SITIO.vistaPrevia && (
      <p class="vista-previa">
        <strong>Vista previa para revisión.</strong> Los datos «Por confirmar» y los temarios están pendientes de validación;
        la inscripción se habilita en la publicación definitiva.
      </p>
    )}
    <Header />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: var(--space-4);
    top: -100px;
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    background: var(--bg-inverse);
    color: var(--text-on-inverse);
    font-weight: 600;
    text-decoration: none;
  }

  .saltar:focus {
    top: var(--space-4);
  }

  .vista-previa {
    padding: var(--space-2) var(--gutter);
    background: var(--bg-inverse);
    color: var(--text-on-inverse);
    font-size: 14px;
    line-height: 1.5;
    text-align: center;
  }

  main:focus {
    outline: none;
  }
</style>
